# --- Core ---
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for encrypting agents' integration credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Platform domains ---
PLATFORM_DOMAIN=bimcrm.ir
PLATFORM_NAMESERVERS=ns1.bimcrm.ir,ns2.bimcrm.ir
# Cookie domain so one login works on bimcrm.ir and every *.bimcrm.ir subdomain
SESSION_COOKIE_DOMAIN=.bimcrm.ir
CSRF_TRUSTED_ORIGINS=https://bimcrm.ir,https://*.bimcrm.ir
SECURE_SSL=True

# --- Services (docker-compose fills these in) ---
DATABASE_URL=postgres://bimcrm:bimcrm@db:5432/bimcrm
REDIS_URL=redis://redis:6379/0

# --- Platform SMS (sms.ir) ---
# console = print codes to the log (development). smsir = send for real.
SMS_BACKEND=console
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_LINE_NUMBER=

# --- Platform payments (Zarinpal) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True

# --- First super admin (created on first deploy if missing) ---
SUPERADMIN_MOBILE=
# Optional: first password. If empty, a random one is printed once in the deploy log.
SUPERADMIN_PASSWORD=
